<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- HEADER: FOTO UTAMA WISATA + TEKS MENYATU -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="340dp">

            <!-- Foto Utama Header -->
            <ImageView
                android:id="@+id/imgHeader"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Foto Utama Wisata"
                android:scaleType="centerCrop"
                android:src="@drawable/img_gunung_dempo" />

            <!-- Tombol Kembali (Back) -->
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:contentDescription="Kembali"
                android:focusable="true"
                android:padding="8dp"
                android:src="?attr/homeAsUpIndicator"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@android:color/white" />

            <!-- Informasi Rating, Judul, dan Lokasi di atas foto -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                app:layout_constraintBottom_toBottomOf="parent">

                <!-- Badge Rating -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_badge_yellow_soft"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp">

                    <TextView
                        android:id="@+id/tvRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐ 4.9 (1.2k Review)"
                        android:textColor="@android:color/black"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Judul -->
                <TextView
                    android:id="@+id/tvJudulWisata"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kebun Teh"
                    android:textColor="@android:color/white"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <!-- Lokasi -->
                <TextView
                    android:id="@+id/tvLokasiWisata"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="📍 Pagar Alam, Sumatera Selatan"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- KONTEN UTAMA DI BAWAH HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- DESKRIPSI -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Deskripsi"
                android:textColor="@android:color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Badge Jam & Harga -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvJamBuka"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_yellow_soft"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="⏳ Setiap hari : 24 jam"
                    android:textColor="@android:color/black"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvHargaTiket"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_yellow_soft"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="🪙 5-20rb"
                    android:textColor="@android:color/black"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDeskripsiWisata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:lineSpacingExtra="4dp"
                android:text="Kebun Teh Pagar Alam adalah perkebunan teh luas di kaki Gunung Dempo dengan pemandangan hijau yang indah dan udara sejuk. Tempat ini cocok untuk bersantai, berfoto, dan menikmati suasana alam yang asri."
                android:textColor="#666666"
                android:textSize="13sp" />

            <!-- FASILITAS / PENGINAPAN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Fasilitas"
                android:textColor="@android:color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- CardView Utama Pembungkus Penginapan -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Judul Sub-bagian Penginapan -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="🏡 Penginapan"
                        android:textColor="@android:color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Horizontal Scroll View agar bisa digeser ke samping -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- KARTU 1 PENGINAPAN -->
                            <androidx.cardview.widget.CardView
                                android:layout_width="220dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="12dp"
                                app:cardBackgroundColor="#F8F9FA"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="10dp">

                                    <ImageView
                                        android:id="@+id/imgPenginapan1"
                                        android:layout_width="match_parent"
                                        android:layout_height="120dp"
                                        android:contentDescription="Foto Penginapan 1"
                                        android:scaleType="centerCrop"
                                        android:src="@drawable/img_glamping" />

                                    <TextView
                                        android:id="@+id/tvNamaPenginapan1"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:text="Dempo Highland Glamping"
                                        android:textColor="@android:color/black"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tvLokasiPenginapan1"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="📍 Kampung II, Gunung Dempo"
                                        android:textColor="#666666"
                                        android:textSize="10sp" />

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="10dp"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:id="@+id/tvInfoKamar1"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:text="8 Kamar, 4 Orang"
                                            android:textColor="#856404"
                                            android:textSize="10sp"
                                            android:textStyle="bold" />

                                        <!-- TOMBOL HUBUNGI PENGINAPAN 1 -->
                                        <Button
                                            android:id="@+id/btnHubungiGlamping"
                                            android:layout_width="wrap_content"
                                            android:layout_height="32dp"
                                            android:backgroundTint="#002B49"
                                            android:minWidth="0dp"
                                            android:minHeight="0dp"
                                            android:paddingHorizontal="12dp"
                                            android:text="Hubungi"
                                            android:textAllCaps="false"
                                            android:textColor="@android:color/white"
                                            android:textSize="10sp" />
                                    </LinearLayout>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <!-- KARTU 2 PENGINAPAN -->
                            <androidx.cardview.widget.CardView
                                android:layout_width="220dp"
                                android:layout_height="wrap_content"
                                app:cardBackgroundColor="#F8F9FA"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="10dp">

                                    <ImageView
                                        android:id="@+id/imgPenginapan2"
                                        android:layout_width="match_parent"
                                        android:layout_height="120dp"
                                        android:contentDescription="Foto Penginapan 2"
                                        android:scaleType="centerCrop"
                                        android:src="@drawable/img_villa" />

                                    <TextView
                                        android:id="@+id/tvNamaPenginapan2"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:text="Villa Rumah Terbuka"
                                        android:textColor="@android:color/black"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tvLokasiPenginapan2"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="📍 Jl. Laskar Wanita Mentri"
                                        android:textColor="#666666"
                                        android:textSize="10sp" />

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="10dp"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:id="@+id/tvInfoKamar2"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:text="2 kamar"
                                            android:textColor="#856404"
                                            android:textSize="10sp"
                                            android:textStyle="bold" />

                                        <!-- TOMBOL HUBUNGI PENGINAPAN 2 -->
                                        <Button
                                            android:id="@+id/btnHubungiVilla"
                                            android:layout_width="wrap_content"
                                            android:layout_height="32dp"
                                            android:backgroundTint="#002B49"
                                            android:minWidth="0dp"
                                            android:minHeight="0dp"
                                            android:paddingHorizontal="12dp"
                                            android:text="Hubungi"
                                            android:textAllCaps="false"
                                            android:textColor="@android:color/white"
                                            android:textSize="10sp" />
                                    </LinearLayout>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- WAHANA DI SEKITAR WISATA -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="#FACC15"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvJudulWahanaSection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="🪂 Wahana di Sekitar Kebun Teh"
                        android:textColor="#0F172A"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="236dp"
                        android:orientation="horizontal">

                        <!-- Kolom Kiri: Wahana 1 -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardWahana1"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <ImageView
                                    android:id="@+id/imgWahana1"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="Foto Wahana 1"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/img_flying_fox" />

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="84dp"
                                    android:layout_gravity="top"
                                    android:background="#55000000" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="top"
                                    android:orientation="vertical"
                                    android:padding="12dp">

                                    <TextView
                                        android:id="@+id/tvJudulWahana1"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Flying Fox"
                                        android:textColor="@android:color/white"
                                        android:textSize="16sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tvDescWahana1"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="Berada di atas ketinggian 100 meter"
                                        android:textColor="#F1F5F9"
                                        android:textSize="10sp" />
                                </LinearLayout>
                            </FrameLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- Kolom Kanan: Wahana 2 & Wahana 3 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <!-- Wahana 2 -->
                            <androidx.cardview.widget.CardView
                                android:id="@+id/cardWahana2"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_marginBottom="6dp"
                                android:layout_weight="1"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp">

                                <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">

                                    <ImageView
                                        android:id="@+id/imgWahana2"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:contentDescription="Foto Wahana 2"
                                        android:scaleType="centerCrop"
                                        android:src="@drawable/img_sepeda_gantung" />

                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="56dp"
                                        android:layout_gravity="top"
                                        android:background="#55000000" />

                                    <TextView
                                        android:id="@+id/tvJudulWahana2"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="top|start"
                                        android:padding="10dp"
                                        android:text="Sepeda\nGantung"
                                        android:textColor="@android:color/white"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />
                                </FrameLayout>
                            </androidx.cardview.widget.CardView>

                            <!-- Wahana 3 -->
                            <androidx.cardview.widget.CardView
                                android:id="@+id/cardWahana3"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_marginTop="6dp"
                                android:layout_weight="1"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp">

                                <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">

                                    <ImageView
                                        android:id="@+id/imgWahana3"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:contentDescription="Foto Wahana 3"
                                        android:scaleType="centerCrop"
                                        android:src="@drawable/img_kereta_api" />

                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="42dp"
                                        android:layout_gravity="top"
                                        android:background="#55000000" />

                                    <TextView
                                        android:id="@+id/tvJudulWahana3"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="top|start"
                                        android:padding="10dp"
                                        android:text="Kereta Api"
                                        android:textColor="@android:color/white"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />
                                </FrameLayout>
                            </androidx.cardview.widget.CardView>

                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- INFORMASI TAMBAHAN -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="ℹ️ Informasi Tambahan"
                        android:textColor="@android:color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvInfoKiri"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="#F1F3F5"
                            android:padding="8dp"
                            android:text="✔ Konfirmasi instan\nE-tiket langsung aktif"
                            android:textColor="#333333"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvInfoKanan"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="#F1F3F5"
                            android:padding="8dp"
                            android:text="🛡 Non-refundable\nSesudah hari ditukar"
                            android:textColor="#333333"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTipsWisata"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#FFF9DB"
                        android:padding="10dp"
                        android:text="Dianjurkan datang saat pagi hari sebelum pukul 08.00 untuk menikmati panorama kabut tipis dan udara terdingin lereng Gunung Dempo."
                        android:textColor="#555555"
                        android:textSize="11sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- TOMBOL LIHAT TINGKAT KERAMAIAN -->
            <Button
                android:id="@+id/btnKeramaian"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:backgroundTint="#FFC107"
                android:text="Lihat Tingkat Keramaian ➔"
                android:textColor="@android:color/black"
                android:textStyle="bold" />

            <!-- ULASAN PENGUNJUNG -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ulasan Pengunjung"
                    android:textColor="@android:color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRatingUlasan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐ 4.9 (124)"
                    android:textColor="@android:color/black"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Card Kotak Ulasan -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardUlasanUtama"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvInisialUlasan"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="#FEF08A"
                            android:gravity="center"
                            android:text="BS"
                            android:textColor="#854D0E"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvNamaUlasan"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Budi Santoso"
                                android:textColor="@android:color/black"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⭐⭐⭐⭐⭐"
                                android:textColor="#EAB308"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvWaktuUlasan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2 minggu lalu"
                            android:textColor="#666666"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvIsiUlasan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Udara sejuk dan pemandangan hamparan tehnya bikin betah."
                        android:textColor="#333333"
                        android:textSize="12sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvLihatSemuaUlasan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:clickable="true"
                android:focusable="true"
                android:text="Lihat Semua Ulasan →"
                android:textColor="#CA8A04"
